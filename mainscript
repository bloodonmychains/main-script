TabBar2.BackgroundTransparency=1; TabBar2.Visible=false

local function SetTab(name)
    for _,def in ipairs(ALL_TABS) do if def[1]==name then TitleLabel.Text=def[2] end end
    for n,page in pairs(tabPages) do page.Visible=(n==name) end
    for n,btn in pairs(tabBtns) do
        btn.BackgroundColor3=n==name and Color3.fromRGB(255,255,255) or Color3.fromRGB(20,20,20)
        btn.TextColor3=n==name and Color3.fromRGB(0,0,0) or Color3.fromRGB(160,160,160)
    end
end

-- Build main tabs
for i,def in ipairs(TAB_DEFS) do
    local name=def[1]
    local xPos=(i-1)*(TAB_W+TAB_GAP)
    local btn=Instance.new("TextButton",TabBar)
    btn.Size=UDim2.new(0,TAB_W,1,0); btn.Position=UDim2.new(0,xPos,0,0)
    btn.Text=name; btn.Font=Enum.Font.Code; btn.TextSize=10
    btn.BackgroundColor3=Color3.fromRGB(20,20,20); btn.TextColor3=Color3.fromRGB(160,160,160)
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)
    tabBtns[name]=btn

    local page
    if name == "Lock" or name == "ESP" then
        page = Instance.new("ScrollingFrame", Frame)
        page.ScrollBarThickness = 2
        page.CanvasSize = UDim2.new(0, 0, 0, name == "ESP" and 350 or 650)
        page.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    else
        page = Instance.new("Frame", Frame)
    end

    page.Size=UDim2.new(1,-16,0,240); page.Position=UDim2.new(0,8,0,62)
    page.BackgroundTransparency=1; page.Visible=false
    tabPages[name]=page
    btn.MouseButton1Click:Connect(function()
        activeTabBar="main"
        TabBar.Visible=true; TabBar2.Visible=false
        SetTab(name)
    end)
end

