local function removeESPForPlayer(plr)
    local d = ESPDrawings[plr]
    if not d then return end
    d.Box:Remove()
    d.Name:Remove()
    d.Distance:Remove()
    d.HealthBg:Remove()
    d.HealthFill:Remove()
    d.ArmorBg:Remove()
    d.ArmorFill:Remove()
    for _, bone in ipairs(d.Bones) do bone:Remove() end
    ESPDrawings[plr] = nil
end

-- REDONE ESP LOGIC [cite: 14, 15, 16]
local function updateESP()
    if not ESPConfig.Enabled then
        for _, d in pairs(ESPDrawings) do hideDrawings(d) end
        return
    end
    for plr, d in pairs(ESPDrawings) do
        local char = plr.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        -- Strict validation to prevent "ghosting"
        if not (char and char.Parent and hum and root and head and hum.Health > 0) then 
            hideDrawings(d)
            continue 
        end

        local rootScreen, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then 
            hideDrawings(d)
            continue 
        end
        
        local headPos = head.Position + Vector3.new(0, 0.8, 0)
        local feetPos = root.Position - Vector3.new(0, 3.2, 0)
        local topScreen = Camera:WorldToViewportPoint(headPos)
        local bottomScreen = Camera:WorldToViewportPoint(feetPos)
        
        local boxH = math.abs(topScreen.Y - bottomScreen.Y)
        local boxW = boxH * 0.6
        local boxX = topScreen.X - boxW/2
        local boxY = topScreen.Y
        
        -- Box [cite: 17, 18]
        d.Box.Visible=ESPConfig.Boxes
        d.Box.Color=ESPConfig.BoxColor
        d.Box.Position=Vector2.new(boxX,boxY)
        d.Box.Size=Vector2.new(boxW,boxH)
        
        -- Name [cite: 19]
        d.Name.Visible=ESPConfig.Names
        d.Name.Color=ESPConfig.NameColor
        d.Name.Text=plr.Name
        d.Name.Position=Vector2.new(topScreen.X, boxY-16)

        -- Feet Away (Distance)
        if ESPConfig.Distance then
            local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) and (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude or 0
            d.Distance.Visible = true
            d.Distance.Text = math.floor(dist) .. " ft"
            d.Distance.Position = Vector2.new(topScreen.X, boxY + boxH + 2)
        else
            d.Distance.Visible = false
        end
        
        -- Health Bar [cite: 20, 21]
        if ESPConfig.Health then
            local hPct = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
            local barX = boxX - 6
            d.HealthBg.Visible = true
            d.HealthBg.Position = Vector2.new(barX, boxY)
            d.HealthBg.Size = Vector2.new(3, boxH)
            d.HealthFill.Visible = true
            d.HealthFill.Color = ESPConfig.HealthBad:Lerp(ESPConfig.HealthGood, hPct)
            d.HealthFill.Position = Vector2.new(barX, boxY + (boxH * (1 - hPct)))
            d.HealthFill.Size = Vector2.new(3, boxH * hPct)
        else
            d.HealthBg.Visible = false
            d.HealthFill.Visible = false
        end

        -- Armor Bar
        if ESPConfig.Armor then
            local armor = char:FindFirstChild("BodyArmor") or char:FindFirstChild("Armor") or char:FindFirstChild("Shield")
            local val, max = 0, 100
            if armor then
                if armor:IsA("ValueBase") then val = armor.Value
                elseif armor:FindFirstChild("Value") then val = armor.Value.Value end
                local m = char:FindFirstChild("MaxArmor") or char:FindFirstChild("MaxShield")
                if m then max = m.Value end
            end
            local aPct = math.clamp(val/max, 0, 1)
            local barX = boxX - (ESPConfig.Health and 11 or 6)
            d.ArmorBg.Visible = true
            d.ArmorBg.Position = Vector2.new(barX, boxY)
            d.ArmorBg.Size = Vector2.new(3, boxH)
            d.ArmorFill.Visible = true
            d.ArmorFill.Position = Vector2.new(barX, boxY + (boxH * (1 - aPct)))
            d.ArmorFill.Size = Vector2.new(3, boxH * aPct)
            d.ArmorFill.Color = ESPConfig.ArmorColor
        else
            d.ArmorBg.Visible = false
            d.ArmorFill.Visible = false
        end
        
        -- Skeleton [cite: 22, 23, 24]
        for i, pair in ipairs(BONE_PAIRS) do
            local bone=d.Bones[i]
            local partA=char:FindFirstChild(pair[1])
            local partB=char:FindFirstChild(pair[2])
            if partA and partB and ESPConfig.Bones then
                local sA,onA=Camera:WorldToViewportPoint(partA.Position)
                local sB,onB=Camera:WorldToViewportPoint(partB.Position)
                if onA and onB then
                    bone.Visible=true
                    bone.Color=ESPConfig.BoneColor
                    bone.From=Vector2.new(sA.X,sA.Y)
                    bone.To=Vector2.new(sB.X,sB.Y)
                else bone.Visible=false end
            else bone.Visible=false end
        end
    end
end

local function getFlameTarget()
    local closest, shortest = nil, math.huge
    local mPos = UserInputService:GetMouseLocation()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(FlameConfig.HitPart) then
            local part = plr.Character[FlameConfig.HitPart]
            local sPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(mPos.X,mPos.Y) - Vector2.new(sPos.X,sPos.Y)).Magnitude
                if dist < shortest then closest=part; shortest=dist end
            end
        end
    end
    return closest
end

local function applyHipHeight()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    HipConfig.OriginalHip = hum.HipHeight
    hum.HipHeight = HipConfig.HipHeight
end

local function revertHipHeight()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if HipConfig.OriginalHip then
        hum.HipHeight = HipConfig.OriginalHip
    end
end

local function startResolver()
    if resolverConnection then return end
    resolverConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            for _, v in pairs(game.Players:GetChildren()) do
                if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = v.Character.HumanoidRootPart
                    local velocity = hrp.Velocity
                    if velocity.Magnitude > 50 or math.abs(velocity.Y) > 30 then
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    else
                        hrp.Velocity = Vector3.new(velocity.X, 0, velocity.Z)
                        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
                    end
                end
            end
        end)
    end)
end

local function stopResolver()
    if resolverConnection then
        resolverConnection:Disconnect()
        resolverConnection = nil
    end
end

