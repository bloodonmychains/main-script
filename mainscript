RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if getgenv().SkyY ~= false then
        local vel = hrp.Velocity
        hrp.Velocity = Vector3.new(vel.X, getgenv().SkyAmountY, vel.Z)
        RunService.RenderStepped:Wait()
        hrp.Velocity = vel
    end
    if getgenv().SkyX ~= false then
        local vel = hrp.Velocity
        hrp.Velocity = Vector3.new(getgenv().SkyAmountX, vel.Y, vel.Z)
        RunService.RenderStepped:Wait()
        hrp.Velocity = vel
    end
end)
