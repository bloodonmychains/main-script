local function MakeSlider(parent, yPos, labelText, min, max, default, callback)
    local sf=Instance.new("Frame",parent)
    sf.Size=UDim2.new(1,0,0,48); sf.Position=UDim2.new(0,0,0,yPos); sf.BackgroundTransparency=1
    local lbl=Instance.new("TextLabel",sf)
    lbl.Size=UDim2.new(1,0,0,18); lbl.Text=labelText..": "..default
    lbl.TextColor3=Color3.new(1,1,1); lbl.Font=Enum.Font.Code; lbl.TextSize=11
    lbl.BackgroundTransparency=1; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local tray=Instance.new("Frame",sf)
    tray.Size=UDim2.new(1,0,0,8); tray.Position=UDim2.new(0,0,0,28)
    tray.BackgroundColor3=Color3.fromRGB(30,30,30); Instance.new("UICorner",tray)
    local fill=Instance.new("Frame",tray)
    fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(255,255,255); Instance.new("UICorner",fill)
    local dragging=false
    local function update(input)
        local pos=math.clamp((input.Position.X-tray.AbsolutePosition.X)/tray.AbsoluteSize.X,0,1)
        local val=math.floor(min+(max-min)*pos)
        fill.Size=UDim2.new(pos,0,1,0); lbl.Text=labelText..": "..val; callback(val)
    end
    tray.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
end

