-- All tab definitions combined for SetTab lookups
local ALL_TABS = {}
for _,d in ipairs(TAB_DEFS) do ALL_TABS[#ALL_TABS+1]=d end
for _,d in ipairs(TAB_DEFS2) do ALL_TABS[#ALL_TABS+1]=d end

local TAB_COUNT=#TAB_DEFS
