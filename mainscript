UserInputService.InputBegan:Connect(function(i,p)
    if p then return end
    if i.KeyCode==MenuKey then Frame.Visible=not Frame.Visible; return end
    if (i.KeyCode==FlameConfig.MouseLockKey or (i.UserInputType==Enum.UserInputType.MouseButton2 and FlameConfig.UseRightClick)) and FlameConfig.MasterLock then
        if FlameConfig.ActivationType=="Toggle" then
            FlameConfig.LockActive=not FlameConfig.LockActive
        else
            FlameConfig.LockActive=true
        end
        flameTargetPart=FlameConfig.LockActive and getFlameTarget() or nil
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if (i.KeyCode==FlameConfig.MouseLockKey or (i.UserInputType==Enum.UserInputType.MouseButton2 and FlameConfig.UseRightClick))
    and FlameConfig.MasterLock and FlameConfig.ActivationType=="Hold" then
        FlameConfig.LockActive=false; flameTargetPart=nil
    end
end)

RunService.RenderStepped:Connect(function()
    local flameActive=FlameConfig.MasterLock and FlameConfig.LockActive
    StatusDot.BackgroundColor3=flameActive and Color3.fromRGB(0,255,100)
        or (FlameConfig.MasterLock and Color3.fromRGB(255,160,0) or Color3.fromRGB(255,0,0))
    flameStatusLbl.Text=flameActive and "Status: LOCKED"
        or (FlameConfig.MasterLock and "Status: READY" or "Status: INACTIVE")
    flameStatusLbl.TextColor3=flameActive and Color3.fromRGB(0,255,100)
        or (FlameConfig.MasterLock and Color3.fromRGB(255,160,0) or Color3.fromRGB(255,0,0))

    local anyAnti=AntiConfig.EnabledY or AntiConfig.EnabledX
    antiStatusLbl.Text=anyAnti and "Status: ACTIVE" or "Status: INACTIVE"
    antiStatusLbl.TextColor3=anyAnti and Color3.fromRGB(0,255,100) or Color3.fromRGB(120,120,120)

    local lockActive=LockConfig.Enabled
    lockStatusLbl.Text=lockActive and "Status: ACTIVE" or "Status: INACTIVE"
    lockStatusLbl.TextColor3=lockActive and Color3.fromRGB(0,255,100) or Color3.fromRGB(120,120,120)

    hipStatusLbl.Text = HipConfig.Enabled and "Status: ACTIVE" or "Status: INACTIVE"
    hipStatusLbl.TextColor3 = HipConfig.Enabled and Color3.fromRGB(0,255,100) or Color3.fromRGB(120,120,120)

    resStatusLbl.Text = ResolverConfig.Enabled and "Status: ACTIVE" or "Status: INACTIVE"
    resStatusLbl.TextColor3 = ResolverConfig.Enabled and Color3.fromRGB(0,255,100) or Color3.fromRGB(120,120,120)

    speedStatusLbl.Text = isSpeedEnabled and "Status: ACTIVE" or "Status: INACTIVE"
    speedStatusLbl.TextColor3 = isSpeedEnabled and Color3.fromRGB(0,255,100) or Color3.fromRGB(120,120,120)

    if FlameConfig.MasterLock and FlameConfig.LockActive and flameTargetPart and flameTargetPart.Parent then
        local tPos=flameTargetPart.Position+(flameTargetPart.Velocity*FlameConfig.Prediction)
        local offset=(Camera.CFrame.RightVector*FlameConfig.LeftOffset)+Vector3.new(0,FlameConfig.UpOffset,0)
        local fScreen,onScreen=Camera:WorldToViewportPoint(tPos+offset)
        if onScreen then
            local mPos=UserInputService:GetMouseLocation()
            pcall(function()
                mousemoverel((fScreen.X-mPos.X)*FlameConfig.Smoothness, (fScreen.Y-mPos.Y)*FlameConfig.Smoothness)
            end)
        end
    end
    updateESP()
end)

